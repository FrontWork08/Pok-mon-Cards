{
  "expo": {
    "name": "Pokémon Cards",
    "slug": "pokemon-cards",
    "owner": "frontwork",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pokemoncards",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e02b9525-0e99-4b45-a84f-1c44501633be",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "X-Frame-Options": "DENY",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "android": {
      "package": "com.frontwork.pokemoncards",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e02b9525-0e99-4b45-a84f-1c44501633be"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
