{
  "expo": {
    "name": "Trainer Collection",
    "slug": "pokemon-cards",
    "owner": "frontwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pokemoncards",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e02b9525-0e99-4b45-a84f-1c44501633be",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que Trainer Collection acesse suas fotos para escolher uma foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.frontwork.pokemoncards",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e02b9525-0e99-4b45-a84f-1c44501633be"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
