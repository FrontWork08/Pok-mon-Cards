{
  "expo": {
    "name": "Trainer Collection",
    "slug": "pokemon-cards",
    "owner": "frontwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pokemoncards",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e02b9525-0e99-4b45-a84f-1c44501633be",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Trainer Collection usa suas fotos somente para você escolher uma imagem de perfil.",
          "cameraPermission": "A Trainer Collection usa a câmera somente quando você escolher tirar uma foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D9B45B",
          "defaultChannel": "default"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#07111F"
    },
    "android": {
      "package": "com.frontwork.pokemoncards",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07111F"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e02b9525-0e99-4b45-a84f-1c44501633be"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#07111F",
    "androidStatusBar": {
      "backgroundColor": "#07111F",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#07111F",
      "barStyle": "light-content"
    }
  }
}
